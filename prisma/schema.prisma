generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: DIRECT_URL is optional for local dev (SQLite fallback).
// On Vercel/Neon, set both DATABASE_URL (pooled) and DIRECT_URL (direct) in the dashboard.
// If DIRECT_URL is not set, Prisma falls back to DATABASE_URL.

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("orderbooker") // "admin" or "orderbooker"
  phone             String?
  email             String?  // admin email for password recovery
  status            String   @default("active") // "active" or "inactive"
  allRoutesEnabled  Boolean  @default(false) // admin can allow OB to see all days' shops
  companyId         String?  // nullable - PRIMARY company (backward compat, first company)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company            Company?         @relation(fields: [companyId], references: [id])
  orderbookerShops   Shop[]
  shopAssignments    ShopOrderbooker[] // additional shop assignments (multi-OB per shop)
  userCompanies      UserCompany[]    // multi-company assignments
  creditTransactions Transaction[] @relation("CreditBy")
  auditLogs          AuditLog[]
  shopNotes          ShopNote[]    @relation("NoteBy")
  shopVisits         ShopVisit[]   @relation("VisitsBy")
  dailyTargetsFor    DailyTarget[] @relation("TargetsFor")
  dailyTargetsBy     DailyTarget[] @relation("TargetsBy")
  preferences        UserPreference?
  routes             RouteTracking[] @relation("RoutesBy")
  passwordResetTokens PasswordResetToken[]

  @@index([username])
  @@index([role])
  @@index([companyId])
}

model Shop {
  id             String   @id @default(cuid())
  name           String
  ownerName      String?
  area           String?
  address        String?
  phone          String?
  routeDays      String[] // ["monday", "thursday"] — supports multiple route days per shop
  orderbookerId  String
  balance        Float    @default(0) // running balance
  creditLimit    Float    @default(0) // 0 = no limit
  status         String   @default("active") // "active" or "inactive"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderbooker      User                @relation(fields: [orderbookerId], references: [id])
  transactions     Transaction[]
  notes            ShopNote[]
  visits           ShopVisit[]
  companyBalances  ShopCompanyBalance[]
  assignedOrderbookers ShopOrderbooker[] // additional orderbooker assignments
  routeStops           RouteStop[]

  @@index([orderbookerId])
  @@index([routeDays])
  @@index([name])
  @@index([area])
}

model Transaction {
  id            String   @id @default(cuid())
  shopId        String
  type          String   // "credit" or "recovery"
  status        String   @default("approved") // "pending", "approved", "rejected"
  amount        Float
  previousBalance Float
  newBalance    Float
  description   String?
  createdBy     String   // userId
  approvedBy    String?  // admin userId who approved
  approvedAt    DateTime?
  rejectReason  String?
  gpsLat        Float?
  gpsLng        Float?
  gpsAddress    String?
  companyId     String?  // nullable - which company this transaction belongs to
  idempotencyKey String? @unique // prevents duplicate recovery submissions
  createdAt     DateTime @default(now())

  shop    Shop           @relation(fields: [shopId], references: [id])
  creator User           @relation("CreditBy", fields: [createdBy], references: [id])
  company Company?       @relation(fields: [companyId], references: [id])

  @@index([shopId])
  @@index([type])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([companyId])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String   // "create", "edit", "credit_post", "recovery_entry", "status_change"
  entityType    String   // "shop", "user", "transaction"
  entityId      String?
  performedBy   String?
  oldValue      String?  // JSON string of old values
  newValue      String?  // JSON string of new values
  description   String?
  createdAt     DateTime @default(now())

  performer User? @relation(fields: [performedBy], references: [id])

  @@index([action])
  @@index([entityType])
  @@index([performedBy])
  @@index([createdAt])
}

// --- New models for mobile app features ---

model ShopNote {
  id        String   @id @default(cuid())
  shopId    String
  note      String
  createdBy String   // userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator User           @relation("NoteBy", fields: [createdBy], references: [id])

  @@index([shopId])
  @@index([createdBy])
}

model ShopVisit {
  id            String   @id @default(cuid())
  shopId        String
  orderbookerId String   // userId
  gpsLat        Float?
  gpsLng        Float?
  gpsAddress    String?
  inRange       Boolean  @default(true) // whether visit was within 100m radius
  createdAt     DateTime @default(now())

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderbooker  User           @relation("VisitsBy", fields: [orderbookerId], references: [id])

  @@index([shopId])
  @@index([orderbookerId])
  @@index([createdAt])
}

model DailyTarget {
  id             String   @id @default(cuid())
  orderbookerId  String   // userId
  target         Float    // monthly recovery target in PKR
  month          String   // "YYYY-MM" format e.g. "2026-05"
  createdBy      String   // admin userId who set the target
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderbooker User           @relation("TargetsFor", fields: [orderbookerId], references: [id])
  creator     User           @relation("TargetsBy", fields: [createdBy], references: [id])

  @@unique([orderbookerId, month])
  @@index([orderbookerId])
  @@index([month])
}

// --- Multi-Company Support ---

model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  tourCompleted  Boolean  @default(false)
  preferences    String?  // JSON string for future extensibility
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Multi-Company Support ---

model Company {
  id               String   @id @default(cuid())
  name             String   @unique // e.g. "CBL", "Cadbury", "Shan Foods"
  description      String?  // optional description
  distributorPhone String?  // distributor contact number shown on receipts
  status           String   @default("active") // "active" or "inactive"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderbookers       User[]
  userCompanies      UserCompany[]     // multi-company assignments via junction
  companyBalances    ShopCompanyBalance[]
  transactions       Transaction[]
  shopOrderbookers   ShopOrderbooker[] // additional OB assignments for this company

  @@index([name])
  @@index([status])
}

model ShopCompanyBalance {
  id          String   @id @default(cuid())
  shopId      String
  companyId   String
  balance     Float    @default(0) // running balance per company
  creditLimit Float    @default(0) // credit limit per company (0 = no limit)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([shopId, companyId]) // one balance per shop per company
  @@index([shopId])
  @@index([companyId])
}

// --- User-Company Junction (Multi-Company Assignment) ---

model UserCompany {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  isPrimary   Boolean  @default(false) // first assigned company is primary
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId]) // one assignment per user-company
  @@index([userId])
  @@index([companyId])
}

// --- Multi-Orderbooker Shop Assignment ---

model ShopOrderbooker {
  id            String   @id @default(cuid())
  shopId        String
  orderbookerId String
  companyId     String   // which company this orderbooker handles for this shop
  routeDays     String[] // route days specific to this assignment (can differ from shop's default)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderbooker  User    @relation(fields: [orderbookerId], references: [id], onDelete: Cascade)
  company      Company @relation(fields: [companyId], references: [id])

  @@unique([shopId, orderbookerId, companyId]) // one assignment per shop-orderbooker-company
  @@index([shopId])
  @@index([orderbookerId])
  @@index([companyId])
}

// --- Route Tracking ---

model RouteTracking {
  id             String   @id @default(cuid())
  orderbookerId  String   // userId
  companyId      String?  // optional - which company route
  routeDate      DateTime @default(now())
  startLat       Float
  startLng       Float
  startTime      DateTime
  endLat         Float?   // nullable until route ends
  endLng         Float?
  endTime        DateTime?
  totalDistance  Float?   // meters - calculated at route end
  totalDuration  Int?     // seconds - calculated at route end
  status         String   @default("ongoing") // "ongoing" or "completed"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderbooker User            @relation("RoutesBy", fields: [orderbookerId], references: [id])
  waypoints   RouteWaypoint[]
  stops       RouteStop[]

  @@index([orderbookerId])
  @@index([status])
  @@index([routeDate])
  @@index([companyId])
}

model RouteWaypoint {
  id        String   @id @default(cuid())
  routeId   String
  lat       Float
  lng       Float
  accuracy  Float?   // GPS accuracy in meters
  timestamp DateTime @default(now())

  route RouteTracking @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([timestamp])
}

model RouteStop {
  id             String    @id @default(cuid())
  routeId        String
  shopId         String
  arrivalTime    DateTime
  departureTime  DateTime? // nullable until checkout
  timeSpent      Int?      // seconds - calculated on departure
  lat            Float
  lng            Float
  recoveryAmount Float?    // if recovery was done at this shop
  entryType      String    @default("field_visit") // "field_visit" or "late_payment"
  createdAt      DateTime  @default(now())

  route RouteTracking @relation(fields: [routeId], references: [id], onDelete: Cascade)
  shop  Shop          @relation(fields: [shopId], references: [id])

  @@index([routeId])
  @@index([shopId])
  @@index([arrivalTime])
}

// --- Email Configuration (Admin sets SMTP from Settings Panel) ---

model EmailConfig {
  id          String   @id @default(cuid())
  smtpHost    String   // e.g. "smtp.gmail.com"
  smtpPort    Int      @default(587) // e.g. 587 for TLS
  smtpUser    String   // sender email address
  smtpPass    String   // app password (encrypted in DB)
  fromName    String?  // display name for "From" field
  useTLS      Boolean  @default(true)
  isConfigured Boolean @default(false) // quick check if email is set up
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Password Reset Token (Forgot Password Flow) ---

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique // unique reset token
  userId    String   // which user requested the reset
  email     String   // email address the token was sent to
  expiresAt DateTime // token expiry (15 minutes)
  used      Boolean  @default(false) // whether token has been used
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
