# ============================================
# Al-Falah Traders - Environment Variables
# ============================================
# Copy this file as .env and fill in your values
# cp .env.example .env
# ============================================

# Neon PostgreSQL Database URL (required)
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: App URL for CORS
NEXT_PUBLIC_APP_URL=https://alfalah-traders.vercel.app
