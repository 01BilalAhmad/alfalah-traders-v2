# ============================================
# Al-Falah Traders - Environment Variables
# ============================================
# Copy this file as .env and fill in your values
# cp .env.example .env
# ============================================

# Neon PostgreSQL - DIRECT Connection URL (used by Prisma for db push/migrations)
# Get the NON-pooled connection string from: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL - DIRECT Connection URL (same as above, for Prisma directUrl)
DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL - POOLED Connection URL (for fast runtime queries)
# Get the POOLED connection string from Neon dashboard
# It should contain "-pooler" in the hostname
# If not set, falls back to DATABASE_URL
DATABASE_URL_POOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: App URL for CORS
NEXT_PUBLIC_APP_URL=https://alfalah-traders.vercel.app

# ============================================
# SECURITY (Tier A fixes — required as of 2026)
# ============================================

# JWT_SECRET — REQUIRED, no default fallback.
# Generate a strong random string (≥ 32 chars):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Set this in Vercel project settings for Production, Preview, AND Development envs.
# If unset, the app will fail-fast on first API request (intentional).
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_HEX_STRING_OF_AT_LEAST_32_CHARS

# CRON_SECRET — REQUIRED for Vercel Cron to call protected cron endpoints.
# Vercel Cron automatically sends this as `Authorization: Bearer <CRON_SECRET>`
# on every cron invocation. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set in Vercel project settings (Production env is enough — only Production runs crons).
# Used by: /api/cron/auto-backup, /api/cron/auto-end-routes, /api/cron/keep-alive
CRON_SECRET=REPLACE_WITH_A_STRONG_RANDOM_HEX_STRING

# CRON_AUTH_TOKEN — LEGACY (still respected for manual triggers with ?token=)
# If you only use Vercel Cron's automatic Bearer header, leave this unset.
# If you want to manually trigger /api/cron/auto-backup?token=<this> from
# your terminal or Postman, set this to the same value as CRON_SECRET.
# CRON_AUTH_TOKEN=

# BACKUP_EMAIL — Optional. Where weekly auto-backup emails are sent.
# Defaults to 'muhmmadbilal1415@gmail.com' if unset.
# BACKUP_EMAIL=you@example.com

