# ============================================
# Al-Falah Traders - Environment Variables
# ============================================
# Copy this file as .env and fill in your values
# cp .env.example .env
# ============================================

# Neon PostgreSQL - Pooled Connection URL (for queries - FASTER)
# Get the POOLED connection string from: https://console.neon.tech
# It should contain "-pooler" in the hostname
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL - Direct Connection URL (for migrations only)
# This is the NON-pooled connection string from Neon dashboard
DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: App URL for CORS
NEXT_PUBLIC_APP_URL=https://alfalah-traders.vercel.app
